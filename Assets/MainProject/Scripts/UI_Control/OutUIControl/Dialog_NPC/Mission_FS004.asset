      nextNodeId: 5
  - nodeId: 5
    terminalText: "\u201C\u542C\u8BF4\u662F\u5728\u9547\u5357\u95E8\u7684\u90A3\u6761\u6CB3\u9053\u7684\u6697\u6E20\u5206\u4E86\u6D41\uFF0C\u5176\u4ED6\u6E20\u7EE7\u7EED\u5206\u4E0B\u53BB\u3002\u5218\u5F5D\u5148\u751F\u8FD9\u6837\u5B89\u6392\u4E00\u5B9A\u6709\u9053\u7406\u3002\u201D"
