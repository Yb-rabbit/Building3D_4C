  - nodeId: 6
    terminalText: "\u201C\u603B\u4E4B\uFF0C\u611F\u8C22\u4F60\u7684\u5E2E\u5FD9\u5566!\u6C5F\u6C34\u8981\u662F\u5168\u704C\u8FDB\u6765\uFF0C\u8FD9\u5EA7\u57CE\u53EF\u5C31\u906D\u6B83\u54AF\u3002\u201D"
