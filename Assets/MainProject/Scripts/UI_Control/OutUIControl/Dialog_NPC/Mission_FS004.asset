      nextNodeId: 4
  - nodeId: 4
    terminalText: "\u201C\u5C31\u76F4\u63A5\u5728\u6865\u65C1\u8FB9\u901A\u6C34\u5417?\u8FD9\u6837\u96BE\u9053\u5C31\u4E0D\u4F1A\u51B2\u57AE\u5B83?\u201D"
