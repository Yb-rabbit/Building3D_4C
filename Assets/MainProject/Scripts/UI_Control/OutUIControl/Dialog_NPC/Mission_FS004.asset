    terminalText: "\u5BF9\u8BDD\u8BF7\u6C42\n\u201C\u771F\u662F\u592A\u60CA\u9669\u4E86!\u8C01\u6562\u60F3\u8FD9\u5927\u5BB6\u4F19\u4E5F\u6709\u88AB\u51B2\u574F\u7684\u65F6\u5019\u2026\u2026\u201D\n"
