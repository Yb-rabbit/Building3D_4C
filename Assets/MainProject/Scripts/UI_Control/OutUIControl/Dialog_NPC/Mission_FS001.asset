  dialogueList:
  - nodeId: 1
    terminalText: "\u5BF9\u8BDD\u8BF7\u6C42\n\u201C\u5582\uFF0C\u5582?\u53E6\u4E00\u8FB9\u6709\u4EBA\u5728\u5417?\u201D(\u9760\u8FD1\u4EE5\u663E\u793A\u9F20\u6807)\n"
