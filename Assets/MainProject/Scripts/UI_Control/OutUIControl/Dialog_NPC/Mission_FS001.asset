    - optionText: "\u5BF9\u65B9\u56DE\u5E94"
      nextNodeId: 2
    - optionText: "(\u65E0\u89C6)"
      nextNodeId: 1
  - nodeId: 2
    terminalText: "\u201C\u4F60\u662F\u4E0D\u662F\u88AB\u56F0\u5728\u91CC\u9762\u4E86?\u8FD9\u6C9F\u91CC\u901A\u9053\u53EF\u957F\uFF0C\u6742\u7269\u4E5F\u4E0D\u5C11\uFF0C\u5916\u5934\u8FD8\u5728\u4E0B\u5927\u96E8\uFF0C\u4F60\u53EF\u8981\u5343\u4E07\u5F53\u5FC3\u5450!\u201D\r"
    choices:
    - optionText: "\u73A9\u5BB6\u56DE\u5E94"
      nextNodeId: 3
  - nodeId: 3
    terminalText: "\u201C\u8FD9\u91CC\u662F\uFF0C\u4EC0\u4E48\u5730\u65B9?\u600E\u4E48\u56DB\u5468\u5982\u6B64\u6F6E\u6E7F\uFF0C\u5374\u4E0D\u89C1\u5F97\u7559\u6709\u6C34?\u201D"
    choices:
    - optionText: "\u5BF9\u65B9\u56DE\u5E94"
      nextNodeId: 4
  - nodeId: 4
    terminalText: "\u201C\u54CE\u5440\uFF0C\u5E74\u8F7B\u4EBA\uFF0C\u4F60\u6B63\u7AD9\u5728\u6C89\u4E95\u8FB9\u4E0A\uFF0C\u672C\u5C31\u662F\u6EE4\u8FC7\u6742\u7269\u7684\u9053\u7406\uFF0C\u81EA\u7136\u4E0D\u5F97\u6709\u6C34\u624D\u662F\u3002!\u201D"
    choices:
    - optionText: "\u5BF9\u65B9\u56DE\u5E94"
      nextNodeId: 5
  - nodeId: 5
    terminalText: "\u201C\u6211\u542C\u5F97\u8FD9\u6C34\u6D41\u8D8A\u6765\u8D8A\u5927\u4E86\uFF0C\u522B\u7AD9\u5728\u90A3\u4E86!\u4F60\u5FEB\u8FC7\u6765\u5427\u2026\u2026\u5E74\u8F7B\u4EBA!\u201D"
