    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 3
  - nodeId: 3
    terminalText: "\u800C\u5F53\u6C5F\u6C34\u9000\u53BB\uFF0C\u6C34\u4F4D\u4F4E\u4E8E\u6C9F\u6E20\u65F6\uFF0C\u57CE\u5185\u84C4\u79EF\u7684\u6C60\u5858\u6C34\u4FBF\u4F1A\u51B2\u5F00\u6C34\u7A97\uFF0C\u547C\u5578\u7740\u6392\u5165\u6C5F\u4E2D\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 4
  - nodeId: 4
    terminalText: "\u800C\u90A3\u4E9B\u88AB\u6392\u51FA\u7684\u6C34\uFF0C\u6700\u7EC8\u4F1A\u6D41\u7ECF\u54EA\u91CC\uFF1F"
