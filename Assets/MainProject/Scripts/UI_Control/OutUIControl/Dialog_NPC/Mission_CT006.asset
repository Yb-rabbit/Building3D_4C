      nextNodeId: 5
  - nodeId: 5
    terminalText: "\u201C\u62A5\uFF01\u89C1\u8D21\u6C34\u52BF\u5DF2\u5E73\u7A33\uFF0C\u6728\u821F\u5DF2\u8FDE\u6BD5\uFF0C\u8BF7\u5927\u4EBA\u5373\u523B\u4E0B\u4EE4\uFF01\u201D"
