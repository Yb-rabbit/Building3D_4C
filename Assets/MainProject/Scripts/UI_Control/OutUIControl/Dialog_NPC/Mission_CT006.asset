    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 2
  - nodeId: 2
    terminalText: "\u5F53\u6C5F\u6C34\u6C34\u4F4D\u9AD8\u65F6\uFF0C\u6C34\u538B\u4F1A\u5C06\u6C89\u91CD\u7684\u6728\u5236\u6C34\u7A97\u7D27\u7D27\u62B5\u6B7B\uFF0C\u6C5F\u6C34\u4F11\u60F3\u8FDB\u57CE\u5206\u6BEB\u3002"
