  dialogueList:
  - nodeId: 1
    terminalText: "\u4EFB\u52A1\u5C0F\u7ED3\n\u798F\u5BFF\u6C9F\u4F9D\u7740\u201C\u4E2D\u95F4\u9AD8\u3001\u56DB\u5468\u4F4E\u201D\u7684\u9F9F\u80CC\u5730\u5F62\uFF0C\u51FF\u51FA\u4E86\u7E82\u4F53\u201C\u798F\u201D\u5B57\u4E0E\u201C\u5BFF\u201D\u5B57\u4E24\u6761\u4E3B\u5E72\u9053\u3002"
