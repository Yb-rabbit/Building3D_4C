    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 6
  - nodeId: 6
    terminalText: "\u62AC\u773C\u671B\u53BB\uFF0C\u4E00\u767E\u591A\u53EA\u5C0F\u821F\u7528\u7EF3\u7D22\u76F8\u8FDE\uFF0C\u968F\u6CE2\u8D77\u4F0F\u3002\u6C5F\u9762\u4E0A\u6A2A\u4E98\u7740\u534A\u622A\u6D6E\u6865\u3002"
