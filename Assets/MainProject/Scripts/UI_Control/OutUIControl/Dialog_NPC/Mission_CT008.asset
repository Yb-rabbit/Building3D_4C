  m_Script: {fileID: 11500000, guid: 53fdc861920ecc142aa95d32f3a802db, type: 3}
  m_Name: Mission_CT008
  m_EditorClassIdentifier: 
  dialogueList:
  - nodeId: 1
    terminalText: "\u4E2D\u56FD\u81EA\u53E4\u6709\u65E0\u6570\u540D\u6865\uFF0C\u8D75\u5DDE\u6865\u575A\u56FA\uFF0C\u5362\u6C9F\u6865\u6CA7\u6851\uFF0C\u4F46\u5EFA\u6625\u95E8\u6D6E\u6865\u5374\u662F\u72EC\u4E00\u65E0\u4E8C\u7684\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 2
  - nodeId: 2
    terminalText: "\u4E0D\u780C\u4E00\u7816\uFF0C\u4E0D\u642D\u4E00\u77F3\uFF0C\u800C\u662F\u7531\u4E00\u767E\u591A\u53EA\u5C0F\u821F\u8FDE\u73AF\u800C\u6210\u3002\u821F\u968F\u6C34\u52BF\uFF0C\u4EBA\u8D70\u6865\u4E0A\uFF0C\u5386\u7ECF\u516B\u767E\u4F59\u5E74\u81F3\u4ECA\u4ECD\u5728\u670D\u5F79\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 3
  - nodeId: 3
    terminalText: "\u57CE\u6709\u6C34\u5858\u84C4\u6C34\uFF0C\u798F\u5BFF\u6C9F\u5BFC\u6C34\uFF0C\u6C34\u7A97\u6321\u6C34\uFF0C\u6D6E\u6865\u89C1\u8BC1\u6C34\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 4
  - nodeId: 4
    terminalText: "\u606D\u559C\u4F60\u3002\u8FD9\u5EA7\u516B\u767E\u5E74\u524D\u7684\u6D6E\u6865\u5728\u4F60\u7684\u5E2E\u52A9\u4E0B\u91CD\u65B0\u88AB\u53D1\u73B0\u3002\u4E5F\u8BB8\uFF0C\u6211\u5E94\u8BE5\u518D\u591A\u8865\u5145\u51E0\u53E5\uFF1F"
    choices:
    - optionText: "\u6D6E\u6865\u5F80\u4E8B"
      nextNodeId: 5
    - optionText: "\u8DF3\u8FC7"
      nextNodeId: 9
  - nodeId: 5
    terminalText: "\u9664\u4E86\u5EFA\u6625\u95E8\u5916\u7684\u4E1C\u6CB3\u6D6E\u6865\uFF0C\u8FD8\u6709\u897F\u6D25\u95E8\u5916\u7684\u897F\u6CB3\u6D6E\u6865\u3001\u5357\u95E8\u5916\u7684\u5357\u6CB3\u6D6E\u6865\u3002"
    choices:
    - optionText: "\u6D6E\u6865\u5F80\u4E8B"
      nextNodeId: 6
  - nodeId: 6
    terminalText: "\u7136\u800C\u65F6\u81F3\u4ECA\u65E5\uFF0C\u968F\u7740\u5C81\u6708\u66F4\u8FED\u4E0E\u73B0\u4EE3\u57CE\u5EFA\uFF0C\u897F\u6CB3\u4E0E\u5357\u6CB3\u4E24\u5EA7\u6D6E\u6865\u65E9\u5DF2\u9690\u5165\u5C18\u70DF\uFF0C\u5316\u4F5C\u4E86\u6C5F\u7554\u7684\u5730\u540D\u3002"
    choices:
    - optionText: "\u6D6E\u6865\u5F80\u4E8B"
      nextNodeId: 7
  - nodeId: 7
    terminalText: "\u2026\u2026\u4E1C\u6CB3\u4E3A\u821F\u5341\u5176\u5341\uFF0C\u897F\u6CB3\u4E3A\u821F\u516D\u5176\u5341\u2026\u2026\u7AE0\u6C34\u897F\u6CE8\u66F0\u897F\u6CB3\uFF0C\u8D21\u6C34\u4E1C\u4E0B\u66F0\u4E1C\u6CB3\uFF0C\u6CB3\u7686\u6DF1\u5E7F\uFF0C\u6D4E\u8005\u8270\u7109\u3002"
    choices:
    - optionText: "\u6D6E\u6865\u5F80\u4E8B"
      nextNodeId: 8
  - nodeId: 8
    terminalText: "\u201C\u897F\u6D25\u65E7\u540D\u77E5\u653F\uFF0C\u7199\u5B81\u95F4\u59CB\u9020\u6D6E\u6881\uFF1B\u5357\u6CB3\u9547\u5357\u95E8\u5916\uFF0C\u6DF3\u7199\u95F4\u5468\u5FC5\u6B63\u59CB\u9020\uFF1B\u4E1C\u6CB3\u4E7E\u9053\u95F4\u6D2A\u8FC8\u5021\u5EFA\uFF0C\u4ECA\u60DF\u6B64\u6865\u72B9\u5728\u3002\u201D"
    choices:
    - optionText: "\u6D6E\u6865\u5F80\u4E8B"
      nextNodeId: 9
  - nodeId: 9
    terminalText: "\u5F53\u4F60\u7684\u811A\u6B65\u4ECE\u8D77\u4F0F\u7684\u6D6E\u6865\u8E0F\u4E0A\u575A\u5B9E\u7684\u9752\u77F3\u677F\uFF0C\u522B\u5FD8\u4E86\u2014\u2014\u8FD9\u5EA7\u57CE\u771F\u6B63\u7684\u5410\u6545\u7EB3\u65B0\uFF0C\u85CF\u5728\u770B\u4E0D\u89C1\u7684\u6DF1\u5904\u3002"
    choices: []
