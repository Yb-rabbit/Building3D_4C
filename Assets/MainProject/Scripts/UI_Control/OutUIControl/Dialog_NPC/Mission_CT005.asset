  dialogueList:
  - nodeId: 1
    terminalText: "\u573A\u666F\u4ECB\u7ECD\n\u8FD9\u91CC\u662F\u4F4D\u4E8E\u57CE\u5317\u7684\u9F9F\u5C3E\u89D2\u3002\u7AE0\u6C5F\u4E0E\u8D21\u6C5F\u5728\u8FD9\u91CC\u6C47\u96C6\u6210\u4E3A\u8D63\u6C5F\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 2
  - nodeId: 2
    terminalText: "\u6C34\u5728\u6C9F\u6E20\u4E2D\u987A\u7740\u5730\u52BF\u52A0\u901F\u5954\u6D8C\uFF0C\u5C31\u50CF\u57CE\u6C60\u7684\u201C\u80A0\u9053\u201D\uFF0C\u8FC5\u901F\u5C06\u591A\u4F59\u7684\u96E8\u6C34\u5411\u4E0B\u3001\u5411\u5916\u8F93\u9001\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 3
  - nodeId: 3
    terminalText: "\u4F3C\u4E4E\u6C42\u63F4\u7684\u58F0\u97F3\u5C31\u5728\u8FD9\u4E0B\u65B9\uFF1A\u6C34\u7A97\u88AB\u77F3\u5934\u5361\u4F4F\u65E0\u6CD5\u6253\u5F00\uFF0C\u9644\u8FD1\u7684\u6697\u9053\u65E0\u6CD5\u6392\u6C34\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 4
  - nodeId: 4
    terminalText: "\u201C\u5582\uFF01\u522B\u5E9F\u52B2\u8BB2\u4E86\uFF0C\u5FEB\u4E9B\u4E0B\u6765\u5E2E\u5FD9\u5F00\u5F00\u2018\u95E8\u2019\u5427\uFF01\u201D\u6C89\u4E95\u4E0B\u65B9\u4F20\u6765\u58F0\u97F3\uFF0C\u8FD8\u6709\u4E00\u9635\u9635\u6C89\u95F7\u7684\u6C34\u54CD\u3002"
    choices:
    - optionText: "\u7EE7\u7EED\u5BF9\u8BDD"
      nextNodeId: 5
  - nodeId: 5
    terminalText: "\u53BB\u4E00\u63A2\u7A76\u7ADF\u5427\u3002\u6B64\u95E8\u7684\u5B9E\u73B0\u539F\u7406\uFF0C\u57CE\u4E2D\u4EA6\u6709\u8BB2\u5E08\u7B54\u7591\u89E3\u60D1\u3002"
