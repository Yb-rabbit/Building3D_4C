      nextNodeId: 2
  - nodeId: 2
    terminalText: "\u6CA1\u6709\u4EBA\u5728\u8FD9\uFF0C\u4E5F\u8BB8\u662F\u4F11\u606F\u53BB\u4E86\u3002\u53EA\u89C1\u8FD9\u5934\u5899\u58C1\u4E0A\u7684\u7816\u5757\u5F88\u957F\uFF0C\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u523B\u7740\u5B57\u3002\r"
