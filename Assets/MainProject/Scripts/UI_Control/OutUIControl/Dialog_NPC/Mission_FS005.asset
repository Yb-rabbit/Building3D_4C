  dialogueList:
  - nodeId: 1
    terminalText: "\u5BF9\u8BDD\u8BF7\u6C42\n\u201C\u6709\u4EBA\u5417?\u6211\u6765\u95EE\u8DEF\u2026\u2026\u201D\n"
