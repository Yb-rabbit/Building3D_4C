    - optionText: "\u73A9\u5BB6\u89C2\u5BDF"
      nextNodeId: 5
  - nodeId: 5
    terminalText: "\u6CA1\u6709\u5176\u4ED6\u53D1\u73B0\uFF0C\u811A\u8FB9\u53EA\u5269\u7528\u77F3\u5757\u53E0\u8D77\u7684\u5C0F\u77F3\u5757\uFF0C\u88AB\u96D5\u523B\u6210\u57CE\u95E8\u9876\u697C\u7684\u6A21\u6837\u3002\u9759\u9759\u6446\u5728\u6EE4\u53E3\u4E0A\u3002"
    choices:
    - optionText: "\u73A9\u5BB6\u89C2\u5BDF"
      nextNodeId: 6
  - nodeId: 6
    terminalText: "\u201C\u563F!\u4E0B\u9762\u7684\uFF0C\u6E05\u7406\u5B8C\u5C31\u5FEB\u4E0A\u6765!\u201D\u5148\u524D\u90A3\u4F4D\u5DE5\u4EBA\u7684\u58F0\u97F3\u4ECE\u4E0D\u8FDC\u5904\u4F20\u6765\u3002"
