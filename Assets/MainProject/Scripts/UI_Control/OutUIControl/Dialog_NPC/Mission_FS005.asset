    - optionText: "\u73A9\u5BB6\u89C2\u5BDF"
      nextNodeId: 3
  - nodeId: 3
    terminalText: "\u4E00\u5757\u7816\u4E0A\u5199\u7740\uFF0C\u201C\u5B8B\u7199\u5B81\u4E2D\uFF0C\u77E5\u5DDE\u5218\u5F5D\u8C0B\u7F6E\u6C34\u7A97\u3002\u5BFF\u6C9F\u53D7\u57CE\u5317\u4E4B\u6C34\uFF0C\u4E1C\u5357\u4E4B\u6C34\u7531\u798F\u6C9F\u800C\u51FA\u3002\u201D"
    choices:
    - optionText: "\u73A9\u5BB6\u89C2\u5BDF"
      nextNodeId: 4
  - nodeId: 4
    terminalText: "\u7EE7\u7EED\u770B\uFF0C\u8FD9\u9762\u5899\u4E0E\u8BB0\u8F7D\u7684\u201C\u9614\u4E8C\u3001\u4E09\u5C3A\uFF0C\u6DF1\u4E94\u3001\u516D\u5C3A\uFF0C\u780C\u4EE5\u7816\uFF0C\u8986\u4EE5\u77F3\u201D\u7684\u63CF\u8FF0\u51E0\u4E4E\u6CA1\u6709\u5DEE\u522B\u3002"
