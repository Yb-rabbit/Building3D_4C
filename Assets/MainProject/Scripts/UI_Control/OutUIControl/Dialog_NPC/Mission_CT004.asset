  - nodeId: 4
    terminalText: "\u9700\u524D\u5F80\u95F8\u53E3\u8FDB\u884C\u6E05\u6DE4\u64CD\u4F5C\u3002\u82E5\u9519\u8FC7\u65F6\u8FB0\uFF0C\u79EF\u6C34\u5C06\u5012\u704C\u798F\u5BFF\u6C9F\uFF0C\u4E0B\u6E38\u6D6E\u6865\u7684\u822A\u9053\u4E5F\u4F1A\u53D7\u963B\u3002"
