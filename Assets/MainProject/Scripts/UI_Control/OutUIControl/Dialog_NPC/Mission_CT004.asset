      nextNodeId: 3
  - nodeId: 3
    terminalText: "\u4F46\u6C34\u5858\u7684\u5BB9\u91CF\u7EC8\u7A76\u6709\u9650\uFF0C\u6C34\u82E5\u662F\u4E0D\u6392\uFF0C\u4F9D\u7136\u4F1A\u6EE1\u6EA2\u3002\u521A\u624D\u770B\u6765\uFF0C\u6C60\u5858\u6C34\u4F4D\u5DF2\u9AD8\u4E8E\u8B66\u6212\u7EBF\u3002"
