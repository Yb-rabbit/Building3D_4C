      nextNodeId: 2
  - nodeId: 2
    terminalText: "\u5730\u8868\u7684\u96E8\u6C34\u987A\u7740\u8857\u5DF7\u6D41\u5165\u6C60\u5858\uFF0C\u88AB\u6682\u65F6\u541E\u54BD\u3001\u84C4\u79EF\u3002\u6C60\u5858\u6C34\u4F4D\u4E0A\u6DA8\uFF0C\u7F13\u89E3\u4E86\u8857\u9762\u7684\u538B\u529B\uFF0C\u8FD9\u662F\u53E4\u57CE\u7684\u7B2C\u4E00\u9053\u5410\u7EB3\u3002"
