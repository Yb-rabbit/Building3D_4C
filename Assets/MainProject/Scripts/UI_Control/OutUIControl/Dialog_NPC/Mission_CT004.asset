  dialogueList:
  - nodeId: 1
    terminalText: "\u4EFB\u52A1\u5C0F\u8BB0\n\u51E4\u51F0\u6C60\u3001\u5636\u9A6C\u6C60\u3001\u91D1\u9C7C\u6C60\u2026\u2026\u8FD9\u4E9B\u6563\u843D\u5728\u6C11\u5C45\u95F4\u7684\u6C34\u6C60\uFF0C\u662F\u57CE\u6C60\u6700\u5148\u5F20\u5F00\u7684\u201C\u80C3\u201D\u3002"
